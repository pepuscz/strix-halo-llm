#!/usr/bin/env bash
set -euo pipefail

readonly STATE=/run/strix-halo-inference-policy
readonly LOCK=/run/lock/strix-halo-inference-policy.lock
readonly RYZENADJ={{ (strix_paths.bin + '/ryzenadj-' + strix_ryzenadj.version) | quote }}
readonly CPU_GOVERNOR={{ strix_policy.cpu_governor | quote }}
readonly CPU_MIN={{ strix_policy.cpu_min_khz }}
readonly CPU_BOOST={{ (strix_gpu_od.cpu_boost if (strix_gpu_od_enabled | default(false) | bool) and (strix_gpu_od | default({})).cpu_boost is defined else strix_policy.cpu_boost) }}
readonly GPU_DPM={{ (strix_gpu_od.gpu_dpm if (strix_gpu_od_enabled | default(false) | bool) and (strix_gpu_od | default({})).gpu_dpm is defined else strix_policy.gpu_dpm) | quote }}
readonly STAPM={{ strix_policy.stapm_mw }}
readonly FAST={{ strix_policy.fast_mw }}
readonly SLOW={{ strix_policy.slow_mw }}
readonly EXPECTED_W={{ strix_policy.expected_watts | quote }}
# (optional) the kernel's memory compaction while the service runs: kcompactd moving pages a GPU maps makes the driver
# stop the process's queues and bind its host memory again - 100-300 ms with the GPUs idle (a DeepSeek EXL3 release
# right after its load). Empty: left as the host has it
readonly VM_COMPACTION_PROACTIVENESS={{ strix_policy.vm_compaction_proactiveness | default('') }}
readonly VM_WATERMARK_BOOST_FACTOR={{ strix_policy.vm_watermark_boost_factor | default('') }}
# (optional, strix_gpu_od_enabled) discrete-GPU OverDrive while the service runs: a voltage offset on the whole V/F curve and a power cap for
# every card with this PCI id (needs amdgpu.ppfeaturemask with bit 0x4000). Empty PCI id: cards left as the host has them
readonly GPU_OD_PCI_ID={{ ((strix_gpu_od | default({})) if (strix_gpu_od_enabled | default(false) | bool) else {}).pci_id | default('') | quote }}
readonly GPU_OD_VOLTAGE_OFFSET_MV={{ ((strix_gpu_od | default({})) if (strix_gpu_od_enabled | default(false) | bool) else {}).voltage_offset_mv | default('') }}
readonly GPU_OD_POWER_CAP_W={{ ((strix_gpu_od | default({})) if (strix_gpu_od_enabled | default(false) | bool) else {}).power_cap_w | default('') }}
readonly GPU_OD_SCLK_MAX_MHZ={{ ((strix_gpu_od | default({})) if (strix_gpu_od_enabled | default(false) | bool) else {}).sclk_max_mhz | default('') }}

fail() { printf 'ERROR: %s\n' "$1" >&2; exit 1; }
read_limit() {
    local source=$1 row=$2
    awk -F '|' -v row="$row" '$2 ~ row {gsub(/[[:space:]]/, "", $3); print $3; exit}' "$source"
}
save_paths() {
    local destination=$1; shift
    : > "$destination"
    local path value
    for path in "$@"; do
        [ -r "$path" ] || continue
        # A runtime-suspended amdgpu card answers EBUSY (empty read) for its DPM level; record the
        # driver default then, so restore never writes an empty value and leaves stale state behind.
        value=$(cat "$path" 2>/dev/null) || value=
        if [ -z "$value" ]; then
            case "$path" in
                */power_dpm_force_performance_level) value=auto ;;
                *) continue ;;
            esac
        fi
        printf '%s|%s\n' "$path" "$value" >> "$destination"
    done
}
restore_paths() {
    local source=$1 path value
    [ -f "$source" ] || return 0
    while IFS='|' read -r path value; do
        [ -w "$path" ] && [ -n "$value" ] || continue
        printf '%s\n' "$value" > "$path"
    done < "$source"
}
od_cards() {
    [ -n "$GPU_OD_PCI_ID" ] || return 0
    local dev
    for dev in /sys/bus/pci/devices/*; do
        [ "$(cat "$dev/vendor" 2>/dev/null)":"$(cat "$dev/device" 2>/dev/null)" = "0x${GPU_OD_PCI_ID%%:*}:0x${GPU_OD_PCI_ID#*:}" ] && echo "$dev"
    done
}
od_sclk_max() { awk '/^OD_SCLK:/ {f = 1; next} f && /^1:/ {gsub(/[^0-9]/, "", $2); print $2; exit}' "$1/pp_od_clk_voltage"; }
od_hwmon() { local h; for h in "$1"/hwmon/hwmon*; do [ -e "$h/power1_cap" ] && { echo "$h"; return 0; }; done; return 1; }
od_apply() {
    local dev h sclk found=0
    for dev in $(od_cards); do
        [ -w "$dev/pp_od_clk_voltage" ] || fail "OverDrive is off for $dev (amdgpu.ppfeaturemask needs bit 0x4000)."
        h=$(od_hwmon "$dev") || fail "No power cap for $dev."
        # the card's own clock ceiling stays as it is: an offset committed alone moves it (+25 MHz measured)
        sclk=${GPU_OD_SCLK_MAX_MHZ:-$(od_sclk_max "$dev")}
        [ -n "$sclk" ] || fail "No OD_SCLK ceiling for $dev."
        printf '%s|%s|%s\n' "$dev" "$(cat "$h/power1_cap")" "$sclk" >> "$STATE/od"
        # one commit for every OverDrive value, after the DPM level is set (a later DPM write can bring back the default clocks)
        printf 'vo %s\n' "$GPU_OD_VOLTAGE_OFFSET_MV" > "$dev/pp_od_clk_voltage"
        printf 's 1 %s\n' "$sclk" > "$dev/pp_od_clk_voltage"
        printf 'c\n' > "$dev/pp_od_clk_voltage"
        printf '%s\n' "$((GPU_OD_POWER_CAP_W * 1000000))" > "$h/power1_cap"
        found=1
    done
    [ -z "$GPU_OD_PCI_ID" ] || [ "$found" -eq 1 ] || fail "No GPU with PCI id $GPU_OD_PCI_ID for OverDrive."
}
od_restore() {
    # before power/control returns to auto: a runtime-suspended card refuses OverDrive writes (EBUSY)
    [ -s "$STATE/od" ] || return 0
    local dev cap sclk h
    while IFS='|' read -r dev cap sclk; do
        printf 'r\n' > "$dev/pp_od_clk_voltage" || true
        printf 'c\n' > "$dev/pp_od_clk_voltage" || true
        if [ -n "$sclk" ]; then   # (the driver's reset leaves the ceiling +25 MHz: the card's own one back)
            printf 's 1 %s\n' "$sclk" > "$dev/pp_od_clk_voltage" || true
            printf 'c\n' > "$dev/pp_od_clk_voltage" || true
        fi
        h=$(od_hwmon "$dev") && [ -n "$cap" ] && printf '%s\n' "$cap" > "$h/power1_cap" || true
    done < "$STATE/od"
}
od_verify() {
    local dev h sclk
    for dev in $(od_cards); do
        grep -A1 '^OD_VDDGFX_OFFSET:' "$dev/pp_od_clk_voltage" | tail -1 | grep -qxF -- "${GPU_OD_VOLTAGE_OFFSET_MV}mV" ||
            fail "$dev voltage offset is not ${GPU_OD_VOLTAGE_OFFSET_MV} mV."
        sclk=$(awk -F '|' -v d="$dev" '$1 == d {print $3; exit}' "$STATE/od" 2>/dev/null)
        [ -n "$sclk" ] && [ "$(od_sclk_max "$dev")" = "$sclk" ] || fail "$dev sclk ceiling is not ${sclk:-recorded} MHz."
        h=$(od_hwmon "$dev") || fail "No power cap for $dev."
        [ "$(cat "$h/power1_cap")" = "$((GPU_OD_POWER_CAP_W * 1000000))" ] || fail "$dev power cap is not ${GPU_OD_POWER_CAP_W} W."
    done
}
capture() {
    mkdir -m 0700 "$STATE"
    save_paths "$STATE/cpu" \
        /sys/devices/system/cpu/cpufreq/boost \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_governor \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq \
        /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq \
        /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference
    save_paths "$STATE/gpu" \
        /sys/class/drm/card*/device/power/control \
        /sys/class/drm/card*/device/power_dpm_force_performance_level
    save_paths "$STATE/vm" \
        ${VM_COMPACTION_PROACTIVENESS:+/proc/sys/vm/compaction_proactiveness} \
        ${VM_WATERMARK_BOOST_FACTOR:+/proc/sys/vm/watermark_boost_factor}
    "$RYZENADJ" --info > "$STATE/power"
}
restore_state() {
    [ -d "$STATE" ] || return 0
    od_restore
    restore_paths "$STATE/vm"
    restore_paths "$STATE/gpu"
    restore_paths "$STATE/cpu"
    if [ -s "$STATE/power" ]; then
        old_stapm=$(read_limit "$STATE/power" 'STAPM LIMIT')
        old_fast=$(read_limit "$STATE/power" 'PPT LIMIT FAST')
        old_slow=$(read_limit "$STATE/power" 'PPT LIMIT SLOW')
        if [ -n "$old_stapm" ] && [ -n "$old_fast" ] && [ -n "$old_slow" ]; then
            "$RYZENADJ" \
                --stapm-limit="$(awk -v v="$old_stapm" 'BEGIN {printf "%.0f", v*1000}')" \
                --fast-limit="$(awk -v v="$old_fast" 'BEGIN {printf "%.0f", v*1000}')" \
                --slow-limit="$(awk -v v="$old_slow" 'BEGIN {printf "%.0f", v*1000}')"
        fi
    fi
    rm -rf -- "$STATE"
}
verify() {
    local path info found_gpu=0
    for path in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
        [ "$(cat "$path")" = "$CPU_GOVERNOR" ] || fail "$path does not match $CPU_GOVERNOR"
    done
    for path in /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq; do
        [ "$(cat "$path")" = "$CPU_MIN" ] || fail "$path does not match $CPU_MIN"
    done
    if [ -r /sys/devices/system/cpu/cpufreq/boost ]; then
        [ "$(cat /sys/devices/system/cpu/cpufreq/boost)" = "$CPU_BOOST" ] || fail 'CPU boost mismatch.'
    fi
    for path in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
        [ -r "$path" ] || continue
        [ "$(cat "$path")" = "$GPU_DPM" ] || fail "$path does not match $GPU_DPM"
        found_gpu=1
    done
    [ "$found_gpu" -eq 1 ] || fail 'No writable GPU performance control found.'
    if [ -n "$VM_COMPACTION_PROACTIVENESS" ]; then
        [ "$(cat /proc/sys/vm/compaction_proactiveness)" = "$VM_COMPACTION_PROACTIVENESS" ] ||
            fail 'vm.compaction_proactiveness mismatch.'
    fi
    if [ -n "$VM_WATERMARK_BOOST_FACTOR" ]; then
        [ "$(cat /proc/sys/vm/watermark_boost_factor)" = "$VM_WATERMARK_BOOST_FACTOR" ] ||
            fail 'vm.watermark_boost_factor mismatch.'
    fi
    od_verify
    info=$(mktemp /run/strix-power.XXXXXX)
    trap 'rm -f -- "$info"' RETURN
    "$RYZENADJ" --info > "$info"
    [ "$(read_limit "$info" 'STAPM LIMIT')" = "$EXPECTED_W" ] || fail 'STAPM readback mismatch.'
    [ "$(read_limit "$info" 'PPT LIMIT FAST')" = "$EXPECTED_W" ] || fail 'fast PPT readback mismatch.'
    [ "$(read_limit "$info" 'PPT LIMIT SLOW')" = "$EXPECTED_W" ] || fail 'slow PPT readback mismatch.'
    rm -f -- "$info"
    trap - RETURN
}
apply() {
    [ ! -e "$STATE" ] || fail "stale policy state exists: $STATE"
    capture
    trap 'restore_state' ERR
    local path
    for path in /sys/class/drm/card*/device/power/control; do
        [ -w "$path" ] && printf 'on\n' > "$path"
    done
    for path in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do printf '%s\n' "$CPU_GOVERNOR" > "$path"; done
    for path in /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq; do printf '%s\n' "$CPU_MIN" > "$path"; done
    for path in /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq; do cat "${path%/*}/cpuinfo_max_freq" > "$path"; done
    for path in /sys/devices/system/cpu/cpufreq/policy*/energy_performance_preference; do
        [ -w "$path" ] && printf 'performance\n' > "$path"
    done
    [ ! -w /sys/devices/system/cpu/cpufreq/boost ] || printf '%s\n' "$CPU_BOOST" > /sys/devices/system/cpu/cpufreq/boost
    for path in /sys/class/drm/card*/device/power_dpm_force_performance_level; do
        [ -w "$path" ] && printf '%s\n' "$GPU_DPM" > "$path"
    done
    od_apply
    [ -z "$VM_COMPACTION_PROACTIVENESS" ] || printf '%s\n' "$VM_COMPACTION_PROACTIVENESS" > /proc/sys/vm/compaction_proactiveness
    [ -z "$VM_WATERMARK_BOOST_FACTOR" ] || printf '%s\n' "$VM_WATERMARK_BOOST_FACTOR" > /proc/sys/vm/watermark_boost_factor
    "$RYZENADJ" --stapm-limit="$STAPM" --fast-limit="$FAST" --slow-limit="$SLOW"
    sleep 2
    verify
    trap - ERR
}

[ "${EUID}" -eq 0 ] || fail 'Run as root.'
exec 9> "$LOCK"
flock 9
case "${1:-status}" in
    apply) apply ;;
    restore) restore_state ;;
    verify|status) verify ;;
    *) fail 'Usage: strix-host-policy {apply|restore|verify|status}' ;;
esac
